# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/university_app

# Google Gemini API Key
# احصل عليه من: https://console.cloud.google.com/
# 1. أنشئ مشروع جديد
# 2. فعّل Google Generative AI API
# 3. اذهب إلى Credentials وأنشئ API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=9000

# JWT Secret
JWT_SECRET=university_secret_key
